includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php

    level: 5

    # A project-local cache. PHPStan's default temp directory is shared across
    # every project on the machine.
    tmpDir: .phpstan

    paths:
        - src
        - config
        - routes

    treatPhpDocTypesAsCertain: false

    # Corrects a wrong annotation in Statamic itself, see the stub for why.
    stubFiles:
        - phpstan/AddonServiceProvider.stub

    # The siblings are `suggest`, not `require`: the bridges implement their
    # contracts and name their classes. Scanned from the test stand-ins, which
    # carry the same declarations, so the bridges are checked against real
    # signatures instead of being reported as unknown. Scanned, not analysed.
    scanFiles:
        - tests/Fakes/webhook-manager.php
